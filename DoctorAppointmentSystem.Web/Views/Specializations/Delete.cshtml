@model DoctorAppointmentSystem.Web.Models.Specialization

@{
    ViewBag.Title = "Delete Specialization";
}

<div class="container mt-5">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h4><i class="bi bi-exclamation-triangle"></i> Confirm Delete</h4>
        </div>
        <div class="card-body">
            <h5>Are you sure you want to delete this specialization?</h5>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>
            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="d-flex justify-content-start align-items-center gap-2 mt-3">
                    <button type="submit" class="btn btn-danger px-3 shadow-sm">
                        <i class="bi bi-trash-fill me-1"></i> Delete
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-3 shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                </div>
            }
        </div>
    </div>
</div>