@model DoctorAppointmentSystem.Web.Models.Doctor

@{
    ViewBag.Title = "Edit Doctor";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h4><i class="bi bi-pencil-square"></i> Edit Doctor</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Edit", "Doctors", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <!-- Doctor Name -->
                <div class="mb-3 row">
                    @Html.LabelFor(m => m.Name, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.EditorFor(m => m.Name, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Hospital Name -->
                <div class="mb-3 row">
                    @Html.LabelFor(m => m.HospitalName, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.EditorFor(m => m.HospitalName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.HospitalName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Registration Number -->
                <div class="mb-3 row">
                    @Html.LabelFor(m => m.RegistrationNo, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.EditorFor(m => m.RegistrationNo, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.RegistrationNo, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Degree -->
                <div class="mb-3 row">
                    @Html.LabelFor(m => m.Degree, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.EditorFor(m => m.Degree, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.Degree, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Visited Time -->
                <div class="mb-3 row">
                    @Html.LabelFor(model => model.VisitedTime, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        <input type="time"
                               class="form-control"
                               name="VisitedTime"
                               value="@(Model.VisitedTime.HasValue ? Model.VisitedTime.Value.ToString(@"hh\:mm") : "")" />
                        @Html.ValidationMessageFor(model => model.VisitedTime, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Experience Years -->
                <div class="mb-3 row">
                    @Html.LabelFor(m => m.ExperienceYears, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.EditorFor(m => m.ExperienceYears, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(m => m.ExperienceYears, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Consultation Fee -->
                <div class="mb-3 row">
                    <label class="col-sm-2 col-form-label fw-semibold">Consultation Fee (৳)</label>
                    <div class="col-sm-10">
                        <div class="input-group">
                            <span class="input-group-text fw-bold">৳</span>
                            @Html.EditorFor(m => m.ConsultationFee, new { htmlAttributes = new { @class = "form-control", placeholder = "e.g. 1000.00" } })
                        </div>
                        @Html.ValidationMessageFor(m => m.ConsultationFee, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Availability -->
                <div class="mb-3 row">
                    @Html.LabelFor(m => m.IsAvailable, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsAvailable, new { @class = "form-check-input" })
                            <label class="form-check-label" for="IsAvailable">Available</label>
                        </div>
                    </div>
                </div>

                <!-- Joining Date -->
                <div class="mb-3 row">
                    @Html.LabelFor(m => m.JoiningDate, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.EditorFor(m => m.JoiningDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                        @Html.ValidationMessageFor(m => m.JoiningDate, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Upload Photo -->
                <div class="mb-3 row">
                    <label class="col-sm-2 col-form-label fw-semibold">Upload New Photo</label>
                    <div class="col-sm-10">
                        <input type="file" id="doctorImageInput" name="imageFile" class="form-control mb-2" accept="image/*" />
                        <div class="d-flex align-items-center gap-3 mt-2">
                            <div class="position-relative">
                                <img id="doctorImagePreview"
                                     src="@(!string.IsNullOrEmpty(Model.ImagePath) ? Url.Content(Model.ImagePath) : "/Images/Doctors/default.png")"
                                     class="img-thumbnail rounded shadow-sm border-2"
                                     style="height:120px;width:120px;object-fit:cover;"
                                     alt="Doctor Photo Preview"
                                     onerror="this.onerror=null;this.src='/Images/Doctors/default.png';" />
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success" id="previewBadge" style="display:none;">
                                    <i class="bi bi-check2"></i> New
                                </span>
                            </div>
                            <div>
                                <div id="previewHelpText" class="text-muted small">
                                    <i class="bi bi-info-circle me-1"></i>Current photo shown above. Select a new photo to see instant live preview.
                                </div>
                                <small class="text-secondary d-block mt-1">Photo will be saved to database when you click <b>Save Changes</b>.</small>
                                <button type="button" id="revertImageBtn" class="btn btn-sm btn-outline-secondary mt-2" style="display:none;">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Revert to current photo
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Specialization -->
                <div class="mb-3 row">
                    @Html.LabelFor(m => m.SpecializationId, "Specialization", htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.DropDownList("SpecializationId", (SelectList)ViewBag.SpecializationId, "-- Select Specialization --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.SpecializationId, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-start align-items-center gap-2 mt-4">
                    <button type="submit" class="btn btn-warning px-4 shadow-sm fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-3 shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const imageInput = document.getElementById('doctorImageInput');
            const imagePreview = document.getElementById('doctorImagePreview');
            const previewBadge = document.getElementById('previewBadge');
            const previewHelp = document.getElementById('previewHelpText');
            const revertBtn = document.getElementById('revertImageBtn');
            const originalSrc = imagePreview ? imagePreview.src : '';

            if (imageInput && imagePreview) {
                imageInput.addEventListener('change', function (e) {
                    const file = e.target.files && e.target.files[0];
                    if (file) {
                        if (!file.type.startsWith('image/')) {
                            alert('Please select a valid image file (PNG, JPG, JPEG, WEBP).');
                            imageInput.value = '';
                            return;
                        }
                        const reader = new FileReader();
                        reader.onload = function (event) {
                            imagePreview.src = event.target.result;
                            if (previewBadge) previewBadge.style.display = 'inline-block';
                            if (previewHelp) {
                                previewHelp.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>New photo selected: ' + file.name + '</span>';
                            }
                            if (revertBtn) revertBtn.style.display = 'inline-block';
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }

            if (revertBtn && imageInput && imagePreview) {
                revertBtn.addEventListener('click', function () {
                    imageInput.value = '';
                    imagePreview.src = originalSrc;
                    if (previewBadge) previewBadge.style.display = 'none';
                    if (previewHelp) {
                        previewHelp.innerHTML = '<i class="bi bi-info-circle me-1"></i>Current photo restored. Choose a new photo to see instant preview.';
                    }
                    revertBtn.style.display = 'none';
                });
            }
        })();
    </script>
}

