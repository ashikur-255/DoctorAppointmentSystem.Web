@model DoctorAppointmentSystem.Web.Models.Doctor

@{
    ViewBag.Title = "Create Doctor";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4><i class="bi bi-person-plus"></i> Create New Doctor</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Create", "Doctors", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <!-- Name -->
                <div class="mb-3 row">
                    @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Experience Years -->
                <div class="mb-3 row">
                    @Html.LabelFor(model => model.ExperienceYears, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.EditorFor(model => model.ExperienceYears, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ExperienceYears, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Consultation Fee -->
                <div class="mb-3 row">
                    <label class="col-sm-2 col-form-label fw-semibold">Consultation Fee (৳)</label>
                    <div class="col-sm-10">
                        <div class="input-group">
                            <span class="input-group-text fw-bold">৳</span>
                            @Html.EditorFor(model => model.ConsultationFee, new { htmlAttributes = new { @class = "form-control", placeholder = "e.g. 1000.00" } })
                        </div>
                        @Html.ValidationMessageFor(model => model.ConsultationFee, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Availability -->
                <div class="mb-3 row">
                    @Html.LabelFor(model => model.IsAvailable, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        <div class="form-check">
                            @Html.CheckBoxFor(model => model.IsAvailable, new { @class = "form-check-input" })
                            <label class="form-check-label" for="IsAvailable">Available</label>
                            @Html.ValidationMessageFor(model => model.IsAvailable, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <!-- Joining Date -->
                <div class="mb-3 row">
                    @Html.LabelFor(model => model.JoiningDate, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.EditorFor(model => model.JoiningDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                        @Html.ValidationMessageFor(model => model.JoiningDate, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Visited Time -->
                <div class="mb-3 row">
                    @Html.LabelFor(model => model.VisitedTime, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.EditorFor(model => model.VisitedTime, new { htmlAttributes = new { @class = "form-control", type = "time" } })
                        @Html.ValidationMessageFor(model => model.VisitedTime, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Hospital Name -->
                <div class="mb-3 row">
                    @Html.LabelFor(model => model.HospitalName, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.EditorFor(model => model.HospitalName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.HospitalName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Registration Number -->
                <div class="mb-3 row">
                    @Html.LabelFor(model => model.RegistrationNo, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.EditorFor(model => model.RegistrationNo, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.RegistrationNo, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Degree -->
                <div class="mb-3 row">
                    @Html.LabelFor(model => model.Degree, htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.EditorFor(model => model.Degree, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Degree, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Upload Photo -->
                <div class="mb-3 row">
                    <label class="col-sm-2 col-form-label fw-semibold">Upload Photo</label>
                    <div class="col-sm-10">
                        <input type="file" id="doctorImageInput" name="imageFile" class="form-control mb-2" accept="image/*" />
                        <div class="d-flex align-items-center gap-3 mt-2">
                            <div class="position-relative d-inline-block">
                                <img id="doctorImagePreview"
                                     src="/Images/Doctors/default.png"
                                     class="img-thumbnail rounded shadow-sm border-2"
                                     style="height:120px;width:120px;object-fit:cover;"
                                     alt="Doctor Photo Preview"
                                     onerror="this.onerror=null;this.src='/Images/Doctors/default.png';" />
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success shadow-sm" id="previewBadge" style="display:none;">
                                    <i class="bi bi-check2"></i> Selected
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Specialization -->
                <div class="mb-3 row">
                    @Html.LabelFor(model => model.SpecializationId, "Specialization", htmlAttributes: new { @class = "col-sm-2 col-form-label" })
                    <div class="col-sm-10">
                        @Html.DropDownList("SpecializationId", (SelectList)ViewBag.SpecializationId, "-- Select Specialization --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.SpecializationId, "", new { @class = "text-danger" })
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-start align-items-center gap-2 mt-4">
                    <button type="submit" class="btn btn-success px-4 shadow-sm fw-semibold">
                        <i class="bi bi-person-plus-fill me-1"></i> Create Doctor
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-3 shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const imageInput = document.getElementById('doctorImageInput');
            const imagePreview = document.getElementById('doctorImagePreview');
            const previewBadge = document.getElementById('previewBadge');
            const previewHelp = document.getElementById('previewHelpText');

            if (imageInput && imagePreview) {
                imageInput.addEventListener('change', function (e) {
                    const file = e.target.files && e.target.files[0];
                    if (file) {
                        if (!file.type.startsWith('image/')) {
                            alert('Please select a valid image file (PNG, JPG, JPEG, WEBP).');
                            imageInput.value = '';
                            return;
                        }
                        const reader = new FileReader();
                        reader.onload = function (event) {
                            imagePreview.src = event.target.result;
                            if (previewBadge) previewBadge.style.display = 'inline-block';
                            if (previewHelp) {
                                previewHelp.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Photo selected: ' + file.name + '</span>';
                            }
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
        })();
    </script>
}
