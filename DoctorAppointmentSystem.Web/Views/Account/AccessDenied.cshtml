@{
    ViewBag.Title = "Access Denied";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow border-0 rounded-4 p-5">
                <div class="mb-4">
                    <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4rem;"></i>
                </div>
                <h2 class="text-danger fw-bold mb-2">Access Denied</h2>
                <p class="text-muted mb-4">
                    You do not have permission to access this page. This section requires Administrator access.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary px-4 rounded-pill">
                        <i class="bi bi-house me-1"></i> Back to Home
                    </a>
                    <a href="@Url.Action("Login", "Account")" class="btn btn-primary px-4 rounded-pill">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Login as Admin
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
