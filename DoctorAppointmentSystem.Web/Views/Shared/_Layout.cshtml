<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Doctor Appointment System</title>

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/Content/Site.css" />
    <link rel="stylesheet" href="~/Content/PagedList.css" />
</head>

<body class="d-flex flex-column min-vh-100">

    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm sticky-top">
        <div class="container">

            <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <i class="bi bi-heart-pulse-fill text-danger fs-4 me-2"></i>
                <span>Doctor Appointment System</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">

                <!-- LEFT MENU -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Doctors" asp-action="Index">
                            <i class="bi bi-person-badge me-1"></i> Doctors
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Patients" asp-action="Index">
                            <i class="bi bi-people me-1"></i> Patients
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Appointments" asp-action="Index">
                            <i class="bi bi-calendar-check me-1"></i> Appointments
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Specializations" asp-action="Index">
                            <i class="bi bi-diagram-3 me-1"></i> Specializations
                        </a>
                    </li>

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-semibold" asp-controller="Admin" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("Doctor"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-info fw-semibold" asp-controller="DoctorPortal" asp-action="Dashboard">
                                <i class="bi bi-hospital me-1"></i> Doctor Portal
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">
                            <i class="bi bi-info-circle me-1"></i> About
                        </a>
                    </li>

                </ul>

                <!-- RIGHT MENU -->
                <ul class="navbar-nav align-items-lg-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item me-lg-2">
                            <span class="nav-link text-light">
                                <i class="bi bi-person-circle text-primary me-1"></i> Welcome, @(ViewBag.UserName ?? User.Identity.Name)
                            </span>
                        </li>

                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="LogOff" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm px-3 rounded-pill">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                        </li>

                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-primary btn-sm px-3 rounded-pill shadow-sm" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i> Register
                            </a>
                        </li>
                    }
                </ul>

            </div>
        </div>
    </nav>

    <!-- ================= MAIN BODY ================= -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- ================= PREMIUM MODERN FOOTER ================= -->
    <footer class="modern-footer mt-auto text-light">
        <!-- TRUST HIGHLIGHTS BAR -->
        <div class="footer-top-bar py-3 border-bottom border-secondary border-opacity-25">
            <div class="container">
                <div class="row g-3 text-center text-md-start">
                    <div class="col-6 col-md-3 d-flex align-items-center justify-content-center justify-content-md-start">
                        <i class="bi bi-patch-check-fill text-primary fs-3 me-2"></i>
                        <div>
                            <div class="fw-bold fs-6">Verified Specialists</div>
                            <small class="text-secondary">Certified Medical Doctors</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 d-flex align-items-center justify-content-center justify-content-md-start">
                        <i class="bi bi-lightning-charge-fill text-warning fs-3 me-2"></i>
                        <div>
                            <div class="fw-bold fs-6">Instant Booking</div>
                            <small class="text-secondary">Quick Chamber Appointment</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 d-flex align-items-center justify-content-center justify-content-md-start">
                        <i class="bi bi-shield-fill-check text-success fs-3 me-2"></i>
                        <div>
                            <div class="fw-bold fs-6">100% Confidential</div>
                            <small class="text-secondary">Encrypted Patient Data</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3 d-flex align-items-center justify-content-center justify-content-md-start">
                        <i class="bi bi-headset text-info fs-3 me-2"></i>
                        <div>
                            <div class="fw-bold fs-6">24/7 Helpline</div>
                            <small class="text-secondary">+880 1708588330</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MAIN FOOTER CONTENT -->
        <div class="container py-5">
            <div class="row g-4">

                <!-- Col 1: Platform Overview -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-heart-pulse-fill text-danger fs-2 me-2"></i>
                        <h4 class="fw-bold text-white mb-0">Doctor Appointment System</h4>
                    </div>
                    <p class="text-secondary mb-3 pe-lg-3 lh-base">
                        A modern and trusted digital healthcare platform dedicated to bridging patients with top-tier specialized doctors across Bangladesh with seamless chamber scheduling.
                    </p>
                    <div class="developer-badge p-2 px-3 rounded-3 bg-secondary bg-opacity-10 d-inline-block border border-secondary border-opacity-25">
                        <small class="text-secondary">Developed with pride by</small>
                        <div class="fw-semibold text-white"><i class="bi bi-code-slash text-info me-1"></i>Ashikur Rahman &bull; Dhaka, Bangladesh</div>
                    </div>
                </div>

                <!-- Col 2: Healthcare Services -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h5 class="fw-bold text-white mb-3 position-relative pb-2 section-title">Services</h5>
                    <ul class="list-unstyled footer-menu">
                        <li class="mb-2"><a asp-controller="Doctors" asp-action="Index"><i class="bi bi-chevron-right me-1 text-primary"></i>Find Doctors</a></li>
                        <li class="mb-2"><a asp-controller="Appointments" asp-action="Create"><i class="bi bi-chevron-right me-1 text-primary"></i>Book Appointment</a></li>
                        <li class="mb-2"><a asp-controller="Specializations" asp-action="Index"><i class="bi bi-chevron-right me-1 text-primary"></i>Specializations</a></li>
                        <li class="mb-2"><a asp-controller="DoctorPortal" asp-action="Dashboard"><i class="bi bi-chevron-right me-1 text-primary"></i>Doctor Portal</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="About"><i class="bi bi-chevron-right me-1 text-primary"></i>About Platform</a></li>
                    </ul>
                </div>

                <!-- Col 3: Policies & Information (User requested) -->
                <div class="col-lg-3 col-md-6 col-6">
                    <h5 class="fw-bold text-white mb-3 position-relative pb-2 section-title">Policies & Info</h5>
                    <ul class="list-unstyled footer-menu">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Shipping"><i class="bi bi-truck me-2 text-info"></i>Shipping Info</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="RefundPolicy"><i class="bi bi-arrow-repeat me-2 text-warning"></i>Return Policy</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-lock me-2 text-success"></i>Privacy Policy</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Terms"><i class="bi bi-file-earmark-ruled me-2 text-danger"></i>Terms of Service</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Faq"><i class="bi bi-question-circle me-2 text-primary"></i>FAQ</a></li>
                    </ul>
                </div>

                <!-- Col 4: Contact & Emergency -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold text-white mb-3 position-relative pb-2 section-title">Contact & Support</h5>
                    <ul class="list-unstyled text-secondary">
                        <li class="mb-2 d-flex align-items-start">
                            <i class="bi bi-geo-alt-fill text-danger fs-5 me-2 mt-1"></i>
                            <span>Dhaka, Bangladesh</span>
                        </li>
                        <li class="mb-2 d-flex align-items-center">
                            <i class="bi bi-telephone-fill text-success fs-5 me-2"></i>
                            <a href="tel:+8801708588330" class="text-secondary text-decoration-none">+880 1708588330</a>
                        </li>
                        <li class="mb-2 d-flex align-items-center">
                            <i class="bi bi-envelope-fill text-primary fs-5 me-2"></i>
                            <a href="mailto:ashikurr255@gmail.com" class="text-secondary text-decoration-none">ashikurr255@gmail.com</a>
                        </li>
                        <li class="mb-2 d-flex align-items-center">
                            <i class="bi bi-clock-fill text-warning fs-5 me-2"></i>
                            <span>Available 24/7 Everyday</span>
                        </li>
                    </ul>
                </div>

            </div>

            <!-- PAYMENT METHODS SECTION -->
            <hr class="my-4 border-secondary border-opacity-25" />

            <div class="row align-items-center gy-3">
                <div class="col-md-6 text-center text-md-start">
                    <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-2">
                        <span class="text-secondary me-2 fw-semibold"><i class="bi bi-credit-card-2-front me-1 text-primary"></i>Payment Methods:</span>
                        <span class="payment-badge"><i class="bi bi-phone-fill text-danger me-1"></i>bKash</span>
                        <span class="payment-badge"><i class="bi bi-phone-fill text-warning me-1"></i>Nagad</span>
                        <span class="payment-badge"><i class="bi bi-credit-card-fill text-info me-1"></i>Visa / Mastercard</span>
                        <span class="payment-badge"><i class="bi bi-cash-stack text-success me-1"></i>Cash on Chamber</span>
                    </div>
                </div>

                <div class="col-md-6 text-center text-md-end">
                    <span class="text-success small fw-semibold">
                        <i class="bi bi-shield-check fs-6 me-1"></i> 256-Bit SSL Encrypted & Secure Booking
                    </span>
                </div>
            </div>
        </div>

        <!-- COPYRIGHT SUB-BAR -->
        <div class="footer-bottom-bar py-3 border-top border-secondary border-opacity-25 text-center text-secondary small">
            <div class="container">
                <p class="mb-0">&copy; @DateTime.Now.Year <strong>Doctor Appointment System</strong>. All rights reserved. Built with modern ASP.NET Core.</p>
            </div>
        </div>
    </footer>

    <!-- ================= BACK TO TOP ================= -->
    <button onclick="topFunction()" id="topBtn" title="Back to top" aria-label="Back to top">
        <i class="bi bi-arrow-up-short fs-4"></i>
    </button>

    <!-- ================= SCRIPTS ================= -->
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("scripts", required: false)

    <script>
        let mybutton = document.getElementById("topBtn");

        window.onscroll = function () {
            if (document.documentElement && document.documentElement.scrollTop > 200) {
                mybutton.style.display = "flex";
            } else {
                mybutton.style.display = "none";
            }
        };

        function topFunction() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>

</body>
</html>

<style>
    /* ================= MODERN PREMIUM FOOTER STYLES ================= */
    .modern-footer {
        background: linear-gradient(180deg, #0f172a 0%, #020617 100%);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
    }

    .footer-top-bar {
        background: rgba(255, 255, 255, 0.02);
    }

    .section-title::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        width: 35px;
        height: 2px;
        background: #0d6efd;
        border-radius: 2px;
    }

    .footer-menu li a {
        color: #94a3b8;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
        display: inline-block;
    }

    .footer-menu li a:hover {
        color: #ffffff;
        transform: translateX(4px);
    }

    .payment-badge {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #e2e8f0;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s;
    }

    .payment-badge:hover {
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
        border-color: rgba(255, 255, 255, 0.25);
    }

    .footer-bottom-bar {
        background: #010409;
    }

    #topBtn {
        display: none;
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 44px;
        height: 44px;
        border: none;
        background: #0d6efd;
        color: white;
        border-radius: 50%;
        cursor: pointer;
        z-index: 999;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(13, 110, 253, 0.4);
        transition: all 0.3s ease;
    }

    #topBtn:hover {
        background: #0b5ed7;
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(13, 110, 253, 0.6);
    }
</style>
